# ── PostHog ────────────────────────────────────────────────────────────────
# Public browser token and ingestion host used by the static-site build.
POSTHOG_PROJECT_TOKEN="phc_..."
POSTHOG_HOST="https://us.i.posthog.com"

# ── Neon ──────────────────────────────────────────────────────────────────
# Connection string de tu proyecto Neon (Dashboard → Connection Details).
# Usa el endpoint "pooled" (-pooler) — es el que corresponde para funciones
# serverless, donde cada invocación abre su propia conexión.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Sitio ─────────────────────────────────────────────────────────────────
# URL pública, se usa para armar los links de confirmación y de baja.
SITE_URL="http://localhost:8888"

# ── Mailgun ───────────────────────────────────────────────────────────────
# Sending → Domains → mg.devschile.cl → Settings, en el dashboard de Mailgun.
MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAILGUN_DOMAIN="mg.devschile.cl"
# "us" (api.mailgun.net) o "eu" (api.eu.mailgun.net) — según cómo se creó la cuenta.
MAILGUN_REGION="us"
MAILGUN_FROM="Semanario devsChile <semanario@mg.devschile.cl>"
